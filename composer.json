{
    "name": "fbpkg/laravel-guards",
    "description": "Authentication guards and session management for Laravel.",
    "keywords": [
        "laravel",
        "authentication",
        "auth",
        "guard",
        "guards",
        "session",
        "token",
        "api-key",
        "fbpkg"
    ],
    "homepage": "https://github.com/fbpkg/laravel-guards",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Farzad Sharifi",
            "email": "dev@farzadblack.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "illuminate/database": "^11.0|^12.0|^13.0",
        "illuminate/http": "^11.0|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "Fbpkg\\Guards\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Fbpkg\\Guards\\GuardsServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
